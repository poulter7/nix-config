# Example terraform.tfvars file
# Copy this to terraform.tfvars and fill in your values

aws_region = "us-east-1"
domain_name = "jonathanpoulter.com"
subdomain = "opengrid"
bucket_name = "jonathanpoulter-opengrid"

# Get your certificate ARN from AWS Certificate Manager (ACM) in us-east-1
# acm_certificate_arn = "arn:aws:acm:us-east-1:ACCOUNT_ID:certificate/CERTIFICATE_ID"

# Password protection settings
enable_password_protection = true

# Option 1: Use AWS Secrets Manager (recommended for production)
# Store credentials in Secrets Manager as JSON: {"username": "your-user", "password": "your-pass"}
secrets_manager_secret_name = "prod/login"

# Option 2: Use Terraform variables (simpler, but less secure)
# Uncomment these and comment out secrets_manager_secret_name to use variables instead
# auth_username = "admin"
# auth_password = "your-secure-password-here"  # Min 8 characters
